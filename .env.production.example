# ==================================================================== #
#  Karo — minimal production environment (free-tier deploy)
#
#  The smallest variable set a public demo-mode deployment needs. Copy
#  it into your host's dashboard (Vercel → Settings → Environment
#  Variables), fill in the blanks, and the platform runs end to end on
#  mock providers: no model keys, no Stripe, no SMTP required.
#
#  Generate secrets with:
#      openssl rand -base64 32   # ENCRYPTION_KEY
#      openssl rand -base64 24   # CRON_SECRET, seed passwords
#
#  Everything optional lives in .env.example with full commentary.
# ==================================================================== #

# ---- CORE ----------------------------------------------------------- #
NODE_ENV=production
APP_URL=https://your-project.vercel.app

# ---- DATABASE ------------------------------------------------------- #
# Neon (free tier) or any Postgres. Migrations run against this URL:
#     DATABASE_URL=… npm run db:migrate
DATABASE_URL=

# ---- SECRETS -------------------------------------------------------- #
# Required in production — the app refuses to boot without it. Must
# decode to exactly 32 bytes: `openssl rand -base64 32`.
ENCRYPTION_KEY=

# Bearer token the scheduler sends to /api/cron/tick (and the three
# individual sweep endpoints). Unset means those endpoints are
# admin-session-only and nothing scheduled will run.
CRON_SECRET=

# ---- MODE ----------------------------------------------------------- #
# Demo mode forces the mock AI + billing providers: the platform is fully
# usable with zero external credentials.
KARO_DEMO_MODE=true
# Whether the login page shows the one-click demo login. Keep true for a
# public showcase; the demo account is sandboxed to its own team.
KARO_ALLOW_DEMO_LOGIN=true

# ---- SANDBOX PROVIDERS ---------------------------------------------- #
# Docker sandboxes cannot run on serverless hosting. The in-memory
# simulator keeps the workspace fully functional; real execution later
# comes from a BYOS worker (worker/karo-worker.mjs) on your own machine.
SANDBOX_PROVIDER=mock

# ---- SAFETY --------------------------------------------------------- #
RATE_LIMIT_DISABLED=false
# Vercel terminates TLS at its edge, which is one hop in the
# X-Forwarded-For chain.
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# ---- SEED (used once, by `npm run db:seed`) -------------------------- #
SEED_ADMIN_EMAIL=admin@your-domain.tld
# The seed REFUSES these two in production if left at the documented
# defaults (karo-admin-2025 / karo-demo-2025) — set random values.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# ---- OPTIONAL (see .env.example for the full set) -------------------- #
# REDIS_URL=                # Upstash free tier; without it the rate
#                           # limiter and cache are per-instance memory
# EMAIL_TRANSPORT=smtp      # console (default) only prints links to logs
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# ERROR_WEBHOOK_URL=
