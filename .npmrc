# ------------------------------------------------------------------ #
#  Karo — npm behaviour
#
#  The dependency set is pinned to exact versions on purpose: this app
#  ships a sandbox runtime and a billing path, and a silent minor bump
#  in a transitive dependency is not an acceptable failure mode.
# ------------------------------------------------------------------ #

# Never write a caret/tilde range when adding a dependency.
save-exact=true

# Refuse to install under a Node version the app does not support
# (package.json → engines.node). Fails fast instead of at runtime.
engine-strict=true

# Always maintain package-lock.json; CI installs with `npm ci`.
package-lock=true

# Keep install output readable in CI logs.
fund=false
audit=false

# Deterministic peer-dependency resolution — no legacy escape hatch.
legacy-peer-deps=false
